# Copy this file to .dev.vars and fill in real values.
# .dev.vars is gitignored — never commit real secrets.
# Restart `wrangler dev` after changes.

# Overrides wrangler.toml [vars] for local dev only — enables /debug/anthropic-agents.
# The deployed Worker uses ENVIRONMENT="production" from wrangler.toml (safe-by-default
# disable of the debug route). Local wrangler dev reads .dev.vars after [vars], so this
# line restores development behavior locally without touching the toml.
ENVIRONMENT=development

# Anthropic API key — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_ME

# GitHub fine-grained personal access token (NOT a classic ghp_... token).
# Resource owner: your own GitHub org or user account (the demo defaults to
#   `semswitch-inc` for the jsdiff-demo target; for self-hosted use, scope
#   to whichever account owns the repo CrowdPatch will operate on).
# Repository access: scope to the repo(s) you want CrowdPatch to fix (the
#   demo defaults to `semswitch-inc/jsdiff-demo`).
# Permissions: Contents R/W, Pull requests R/W, Issues Read.
# Create at https://github.com/settings/personal-access-tokens/new
GITHUB_DEMO_PAT=github_pat_REPLACE_ME

# Managed Agent + Environment IDs.
# Populated by `npm run bootstrap:anthropic` (one-shot, idempotent).
# Restart `wrangler dev` after pasting these in.
# ANTHROPIC_AGENT_ID=agent_01...
# ANTHROPIC_ENVIRONMENT_ID=env_01...
