# Copy to .env.production.local for production builds (`npm run build` /
# `npm run deploy`). Gitignored once copied — your real API URL stays
# off GitHub.
#
# Set this to your deployed API host. Defaults shown below cover the two
# common deploy paths from the root README "Deploy your own CrowdPatch
# on Cloudflare" section:
#
#   workers.dev subdomain:  https://crowdpatch-api.<your-subdomain>.workers.dev
#   custom domain:          https://api.your-zone.example
NEXT_PUBLIC_API_BASE=https://crowdpatch-api.example.workers.dev
